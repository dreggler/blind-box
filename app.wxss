/* 全局样式 */
page {
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
}

.container {
  padding: 0;
  background-color: #fff;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-actions {
  display: flex;
  gap: 30rpx;
}

.header-icon {
  font-size: 32rpx;
  color: #666;
}

.card {
  background-color: #fff;
  border-radius: 12rpx;
  margin: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: #fff;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.verified {
  color: #4facfe;
  font-size: 24rpx;
  margin-left: 8rpx;
}

.user-status {
  font-size: 24rpx;
  opacity: 0.9;
}

.recommendation-text {
  padding: 20rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f9f9f9;
}

.tags {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.description {
  padding: 0 20rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
}

.card-image {
  width: 100%;
  height: 500rpx;
  object-fit: cover;
}

.card-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.like-btn {
  background-color: #ff6b6b;
  color: #fff;
}

.dislike-btn {
  background-color: #e0e0e0;
  color: #666;
}

.price {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: 600;
}

.image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.btn {
  display: inline-block;
  padding: 12rpx 32rpx;
  background-color: #ff4757;
  color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  text-align: center;
  margin-top: 16rpx;
}

.input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  resize: none;
}

.order-status {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-top: 8rpx;
  font-weight: 500;
}