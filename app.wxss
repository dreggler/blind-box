/* 全局样式 */
page {
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
}

.container {
  padding: 20rpx;
}

.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.price {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: 600;
}

.image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.btn {
  display: inline-block;
  padding: 12rpx 32rpx;
  background-color: #ff4757;
  color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  text-align: center;
  margin-top: 16rpx;
}

.input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  resize: none;
}