  <input class="input" placeholder="价格" type="number" bindinput="onPriceInput" />
  <textarea class="textarea" placeholder="描述" bindinput="onDescInput" />
  <view class="btn" bindtap="chooseImage">选择图片</view>
  <view class="btn" bindtap="publish">发布</view>
</view>